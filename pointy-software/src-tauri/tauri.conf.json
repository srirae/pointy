{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pointy",
  "version": "0.1.0",
  "identifier": "com.sriva.pointy-software",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pointy",
        "width": 1120,
        "height": 780,
        "minWidth": 880,
        "minHeight": 660,
        "center": true,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "Pointy",
        "url": "overlay.html",
        "width": 1920,
        "height": 1080,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
