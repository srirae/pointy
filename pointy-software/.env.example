# Read by the Rust backend only — never exposed to the webview, so do not add a
# VITE_ prefix (Vite would inline it into the shipped bundle). Copy this file to
# .env and paste your keys. Providers are used fastest-first; add any you like.
#
# Groq — free tier, fastest; chat + Whisper speech-to-text (console.groq.com/keys).
GROQ_API_KEY=
# Google Gemini — free tier (aistudio.google.com/apikey).
GEMINI_API_KEY=
# OpenRouter — free (:free) models (openrouter.ai/keys).
OPEN_ROUTER_API_KEY=
# NVIDIA — Whisper speech-to-text fallback only.
NVIDIA_API_KEY=
# Anthropic Claude — paid backup only, attempted after all free vision providers fail.
ANTHROPIC_API_KEY=
# Optional custom asset URLs used by postinstall/release bootstrap (defaults are used
# when unset — only set these to mirror the downloads behind a different host).
# POINTY_PIPER_URL=
# POINTY_WHISPER_URL=